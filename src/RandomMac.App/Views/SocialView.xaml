<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="RandomMac.App.Views.SocialView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <StackPanel Spacing="20" Padding="32,24,32,28">

            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding [Social_Title], Source={StaticResource Loc}}"
                           FontSize="22"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding [Social_Subtitle], Source={StaticResource Loc}}"
                           Opacity="0.7"
                           FontSize="13"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- Quick actions: Donate (with MenuFlyout) + Report Bug -->
            <StackPanel Orientation="Horizontal" Spacing="10">

                <!-- Donate: opens a flyout with all 4 donation channels.
                     Clicks dispatched via OnLinkClick (code-behind) using
                     each item's Tag, so the flyout never relies on
                     Command binding (WinUI 3 flyout DataContext can drift). -->
                <Button Style="{ThemeResource AccentButtonStyle}" Padding="20,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="Segoe Fluent Icons"
                                  Glyph="&#xEB51;"
                                  FontSize="14" />
                        <TextBlock Text="{Binding [Social_Donate], Source={StaticResource Loc}}" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="Ko-fi"
                                            Tag="https://ko-fi.com/skullmute"
                                            Click="OnLinkClick" />
                            <MenuFlyoutItem Text="Buy Me a Coffee"
                                            Tag="https://www.buymeacoffee.com/skullmute"
                                            Click="OnLinkClick" />
                            <MenuFlyoutItem Text="Patreon"
                                            Tag="https://www.patreon.com/skullmute"
                                            Click="OnLinkClick" />
                            <MenuFlyoutItem Text="PayPal"
                                            Tag="https://paypal.me/DungDang212"
                                            Click="OnLinkClick" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <!-- Report a Bug: opens GitHub Issue with bug_report template
                     pre-selected (?template=bug_report.yml). -->
                <Button Click="OnLinkClick"
                        Tag="https://github.com/poli0981/randomizerMAC/issues/new?template=bug_report.yml"
                        Padding="20,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="Segoe Fluent Icons"
                                  Glyph="&#xEBE8;"
                                  FontSize="14" />
                        <TextBlock Text="{Binding [Social_ReportBug], Source={StaticResource Loc}}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Networks section -->
            <TextBlock Text="{Binding [Social_Networks], Source={StaticResource Loc}}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Opacity="0.7"
                       Margin="0,4,0,0" />

            <ItemsRepeater ItemsSource="{Binding SocialLinks}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="220"
                                       MinItemHeight="52"
                                       MinRowSpacing="8"
                                       MinColumnSpacing="8"
                                       ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Button Click="OnLinkClick"
                                Tag="{Binding Url}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Platform}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Handle}"
                                           Opacity="0.6"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- Contact -->
            <TextBlock Text="{Binding [Social_Contact], Source={StaticResource Loc}}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Opacity="0.7"
                       Margin="0,8,0,0" />
            <HyperlinkButton Content="lopop05905@proton.me"
                             NavigateUri="mailto:lopop05905@proton.me"
                             HorizontalAlignment="Left"
                             Padding="0" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
