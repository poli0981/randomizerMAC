# Normalize line endings: LF in the repository and in the working tree on every OS.
# (The maintainer's machine has core.autocrlf=true; this file overrides it so rustfmt,
# Prettier and shell scripts behave identically on Windows and Linux.)
* text=auto eol=lf

*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

*.png   binary
*.ico   binary
*.icns  binary
*.jpg   binary
*.gif   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.zip   binary
*.gz    binary
*.bin   binary

# Generated / vendored data — keep out of language stats and diffs.
crates/randommac-core/src/oui/vendors.rs linguist-generated=true
crates/randommac-core/src/oui/index.bin linguist-generated=true
package-lock.json linguist-generated=true -diff
Cargo.lock linguist-generated=true
